# =============================================================================
# XMRig Dashboard - Environment Configuration
# =============================================================================
# Copy this file to .env (or ~/.xmrig-dashboard/.env) and fill in values.
# All variables are optional unless marked REQUIRED.

# -----------------------------------------------------------------------------
# Data Directory
# Where DB, secrets, and .env are stored. Defaults to ~/.xmrig-dashboard
# -----------------------------------------------------------------------------
XMRIG_DATA_DIR=

# -----------------------------------------------------------------------------
# Auth.js / NextAuth
# AUTH_SECRET auto-generated and saved to $XMRIG_DATA_DIR/auth-secret if blank.
# Set AUTH_ENABLED=true to require login. Disabled by default for solo instances.
# -----------------------------------------------------------------------------
AUTH_ENABLED=false
AUTH_SECRET=

# Comma-separated emails allowed to sign in.
# Leave empty to allow ALL emails (development only).
AUTH_ALLOWED_EMAILS=admin@example.com,user@example.com

# --- GitHub OAuth ---
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- GitLab OAuth ---
AUTH_GITLAB_ID=
AUTH_GITLAB_SECRET=

# --- Google OAuth ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Microsoft Entra ID (Azure AD) OAuth ---
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# -----------------------------------------------------------------------------
# Email / OTP Delivery (SMTP)
# Without SMTP, OTP codes are logged to the server console (dev mode).
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@xmrig-dashboard.local

# -----------------------------------------------------------------------------
# Database
# Defaults to $XMRIG_DATA_DIR/xmrig-dashboard.db
# -----------------------------------------------------------------------------
XMIG_DASHBOARD_DB=

# -----------------------------------------------------------------------------
# Cron / Background Jobs
# Bearer token for /api/cron and /api/cron/retention endpoints.
# -----------------------------------------------------------------------------
XMRIG_CRON_SECRET=change-me

# -----------------------------------------------------------------------------
# P2Pool Local API
# Directory containing P2Pool JSON files (local/stratum, network/stats, etc.)
# Defaults to ../p2pool/api relative to data dir.
# -----------------------------------------------------------------------------
P2POOL_API_DIR=

# -----------------------------------------------------------------------------
# Sentry (tracing & error monitoring)
# Without SENTRY_DSN, Sentry is disabled entirely.
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# -----------------------------------------------------------------------------
# Development
# Comma-separated origins allowed to access Next.js dev resources (HMR, etc.)
# Example: 192.168.2.100,http://localhost:3000
# -----------------------------------------------------------------------------
ALLOWED_DEV_ORIGINS=192.168.2.100
